# Backend environment for W1 pilot smoke test.
#
# This file is read by `app/config.py` at process start. Lines starting
# with `#` are ignored. Empty values are accepted (the system is
# designed to no-op when an optional provider is unconfigured).
#
# ────────────────────────────────────────────────────────────────────
# AI EXPLANATIONS (at least one required for explanations to work)
# ────────────────────────────────────────────────────────────────────
#
# Leave Ollama Cloud blank since you are running on GitHub Models.
# The router auto-falls-through to GitHub Models when Ollama is empty.
# OLLAMA_CLOUD_URL=
# OLLAMA_MODEL=llama3.2

# GitHub Models — primary provider for W1.
#
# Generate at: https://github.com/settings/tokens
# Required scope: "Models: Read" (added via the fine-grained token UI
# or by ensuring the classic PAT was created after late 2024).
GITHUB_MODELS_PAT=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# Groq Cloud — RECOMMENDED for the automated task-battery evaluation
# (scripts/evaluate_task_battery.py). Free tier is 14,400 req/min vs
# GitHub Models' 50 req/month. Get a key at https://console.groq.com/keys
# (no credit card, ~2 minutes). Default model: llama-3.1-70b-versatile
# (comparable quality to gpt-4o-mini on code-debugging tasks).
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# ────────────────────────────────────────────────────────────────────
# SUPABASE — required for auth, trace persistence, telemetry
# ────────────────────────────────────────────────────────────────────
#
# Two ways to fill these:
# (a) Use a real Supabase project: get the URL + service-role key from
#     https://supabase.com/dashboard/project/<id>/settings/api
# (b) Use the bundled local stack: `docker compose up -d supabase-db`
#     → set SUPABASE_URL=http://localhost:54321 and SUPABASE_SERVICE_KEY
#     to the value of POSTGRES_PASSWORD from your .env.
#
# ────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Anon key (used by the frontend, not the backend). For the smoke test
# the backend does not validate this; the frontend reads it from
# NEXT_PUBLIC_SUPABASE_ANON_KEY at build time. Included here for
# single-file copy/paste from one source of truth.
SUPABASE_ANON_KEY=

# ────────────────────────────────────────────────────────────────────
# REDIS — optional. Set REDIS_ENABLED=true once you've spun up Redis.
# ────────────────────────────────────────────────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ────────────────────────────────────────────────────────────────────
# Application
# ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Per-user rate limit. Pilot participants each get their own JWT and
# own bucket, so the default 20 traces/hour is fine for the pilot.
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_WINDOW_SECONDS=3600

# Hard ceiling on concurrent trace subprocesses. Default 25 is fine.
MAX_CONCURRENT_TRACES=25

# ────────────────────────────────────────────────────────────────────
# Pilot-study settings (W1)
# ────────────────────────────────────────────────────────────────────
# When true, the backend writes extra structured logs whenever a request
# carries the X-Study-Session header. Default true for the pilot — turn
# off after data collection completes.
PILOT_LOG_STUDY_SESSIONS=true
